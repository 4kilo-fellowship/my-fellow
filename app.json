{
  "build": {
    "production": {
      "android": {
        "buildType": "app-bundle",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "ios": {
        "simulator": false,
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "development": {
      "android": {
        "buildType": "apk",
        "env": {
          "NODE_ENV": "development"
        }
      },
      "ios": {
        "simulator": true,
        "env": {
          "NODE_ENV": "development"
        }
      }
    }
  }
}
