{
  "expo": {
    "name": "My Fellow",
    "slug": "my-fellow",
    "scheme": "my-fellow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/images/4kk.png",
    "splash": {
      "image": "./assets/images/logo-white.png",
      "backgroundColor": "#ff6719",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.natitam1.myfellow",
      "icon": "./assets/images/4kk.png"
    },
    "android": {
      "package": "com.natitam1.myfellow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/4kk.png",
        "backgroundColor": "#ff6719"
      }
    },
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "0957bdbf-a7f2-45cf-bf64-47e89c33eca8"
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    "plugins": ["expo-font", "expo-router"]
  }
}
