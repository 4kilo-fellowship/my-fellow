{
  "expo": {
    "name": "My Fellow",
    "slug": "my-fellow",
    "scheme": "my-fellow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["assets/*"],
    "icon": "./assets/images/4kk.png",
    "splash": {
      "image": "./assets/images/primary.png",
      "resizeMode": "contain",
      "backgroundColor": "#ff6719"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.natitam1.myfellow",
      "icon": "./assets/images/4kk.png"
    },
    "android": {
      "package": "com.natitam1.myfellow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/4kk.png",
        "backgroundColor": "#ff6719"
      }
    },
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "env": {
        "NODE_ENV": "development"
      },
      "router": {},
      "eas": {
        "projectId": "18b30bd0-8687-42cc-b007-63b5c23ef01d"
      }
    },
    "plugins": ["expo-font", "expo-router", "expo-splash-screen"]
  }
}
