{
  "expo": {
    "name": "My Fellow",
    "slug": "my-fellow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/images/4k_icon.png",
    "splash": {
      "backgroundColor": "#ff6719",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.natitam1.myfellow",
      "icon": "./assets/images/4k_icon.png"
    },
    "android": {
      "package": "com.natitam1.myfellow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/4k_icon.png",
        "backgroundColor": "#ff6719"
      }
    },
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "0957bdbf-a7f2-45cf-bf64-47e89c33eca8"
      }
    },
    "build": {
      "production": {
        "android": {
          "buildType": "app-bundle",
          "env": {
            "NODE_ENV": "production"
          }
        },
        "ios": {
          "simulator": false,
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "development": {
        "android": {
          "buildType": "apk",
          "env": {
            "NODE_ENV": "development"
          }
        },
        "ios": {
          "simulator": true,
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    }
  }
}
