{
  "expo": {
    "name": "My Fellow",
    "slug": "my-fellow",
    "scheme": "my-fellow",
    "version": "1.2.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/*"
    ],
    "icon": "./assets/images/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aau.ecsf.myfellow",
      "icon": "./assets/images/app-icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.aau.ecsf.myfellow",
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FF6719"
      }
    },
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "env": {
        "NODE_ENV": "development"
      },
      "router": {},
      "eas": {
        "projectId": "0cd82926-55b4-4421-b89c-5da2ad3f85de"
      }
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 270,
          "resizeMode": "contain",
          "backgroundColor": "#FF6719",
          "dark": {
            "image": "./assets/images/splash-logo.png",
            "backgroundColor": "#FF6719"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "owner": "arat-kilo-fellowship",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0cd82926-55b4-4421-b89c-5da2ad3f85de"
    }
  }
}
