{
  "expo": {
    "name": "My Fellow",
    "slug": "my-fellow",
    "scheme": "my-fellow",
    "version": "1.2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["assets/*"],
    "icon": "./assets/images/4kk.png",
    "splash": {
      "backgroundColor": "#ff6719"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aau.ecsf.myfellow",
      "icon": "./assets/images/4kk.png",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.aau.ecsf.myfellow",
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/4kk.png",
        "backgroundColor": "#ff6719"
      }
    },
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "env": {
        "NODE_ENV": "development"
      },
      "router": {},
      "eas": {
        "projectId": "0cd82926-55b4-4421-b89c-5da2ad3f85de"
      }
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "owner": "arat-kilo-fellowship",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0cd82926-55b4-4421-b89c-5da2ad3f85de"
    }
  }
}
